FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

FROM base AS builder
RUN pip install --upgrade pip setuptools wheel
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

FROM base AS final
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

RUN groupadd -r secureclaw && useradd -r -g secureclaw secureclaw

COPY backend/ ./backend/
COPY pyproject.toml .

RUN mkdir -p /app/data/vault /app/data/workspace \
    && chown -R secureclaw:secureclaw /app/data

USER secureclaw

CMD ["python", "-m", "uvicorn", "backend.core.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
