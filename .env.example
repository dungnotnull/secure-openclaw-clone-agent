# Environment Configuration — SecureClawAgent
# Copy this file to .env and fill in your values.

# ---- LLM Provider ----
# Options: claude | openai | ollama
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
OLLAMA_MODEL=mistral:7b

# ---- Encryption ----
# Master encryption key (auto-generated on first run if empty).
# DO NOT hardcode a key here for production; let the system
# derive it from your password via Argon2id.
DB_PRAGMA_KEY=

# ---- Auth ----
# JWT secret (auto-generated if empty — change in production)
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
TOTP_ISSUER=SecureClawAgent

# ---- Sandbox ----
DOCKER_BASE_IMAGE=secureclaw-sandbox:latest
DOCKER_NETWORK_MODE=none
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
DOCKER_TIMEOUT_SECONDS=300

# ---- Limits ----
TASK_TOKEN_BUDGET=100000
ACTION_MAX_RETRIES=3

# ---- Security ----
PII_SCRUB_ENABLED=true
PROMPT_INJECTION_DETECT_ENABLED=true
